# Replaces the repository-root .dockerignore for
# `docker build -f apps/worker/Dockerfile .`.
# The worker image copies packages/ (shared and detector) and apps/worker.
# Legacy weights, the web app, git, and docs stay out of the context.

*

!/packages
!/packages/**

!/apps
!/apps/worker
!/apps/worker/**

# Junk inside the kept trees. Later lines win.
**/__pycache__
**/*.pyc
**/*.pyo
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/*.egg-info
**/.venv
**/venv
**/node_modules
**/.env
**/.env.*
**/tests
**/*.md
/apps/worker/Dockerfile
/apps/worker/Dockerfile.dockerignore
