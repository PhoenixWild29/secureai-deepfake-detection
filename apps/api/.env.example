# Private workstation defaults. Do not commit a filled-in copy.
# AUTH_MODE=dev accepts only "Authorization: Bearer dev".
# Do not use it on a public host. Production stays on AUTH_MODE=clerk
# and requires CLERK_ISSUER.
AUTH_MODE=dev
DEV_AUTH_SUBJECT=user_dev
# CLERK_ISSUER=https://<slug>.clerk.accounts.dev
# CLERK_JWKS_URL=
# Production: comma-separated azp allow-list. Empty skips the azp check (local Clerk only).
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000

DATABASE_URL=postgresql+psycopg://secureai:secureai@127.0.0.1:5432/secureai
REDIS_URL=redis://127.0.0.1:6379/0
QUEUE_BACKEND=redis
QUEUE_KEY=secureai:jobs

STORAGE_BACKEND=filesystem
# Absolute path shared by the API and the worker. A relative path breaks after `cd apps/api`.
MEDIA_ROOT=/var/lib/secureai/media
# STORAGE_BACKEND=s3
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=secureai
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
# Leave false in production. true is for MinIO/local only.
# S3_AUTO_CREATE_BUCKET=false

# Per caller, per window. 0 disables a bucket. Redis-backed when QUEUE_BACKEND=redis.
# RATE_LIMIT_JOBS=30
# RATE_LIMIT_UPLOADS=60
# RATE_LIMIT_WINDOW_SECONDS=60
# DETECTOR_TIMEOUT_SECONDS=60
# STUCK_JOB_SECONDS=180
# JOB_MAX_ATTEMPTS=3

# Explicit origins only. The API rejects CORS_ORIGINS=*.
CORS_ORIGINS=http://localhost:3000

# Worker: cpu reads frames. stub hashes the path.
DETECTOR_MODE=cpu
