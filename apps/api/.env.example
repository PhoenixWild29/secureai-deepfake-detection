# Private workstation defaults. Do not commit a filled-in copy.
# AUTH_MODE=dev accepts only "Authorization: Bearer dev".
# Do not use it on a public host. Production stays on AUTH_MODE=clerk
# and requires CLERK_ISSUER.
AUTH_MODE=dev
DEV_AUTH_SUBJECT=user_dev
# CLERK_ISSUER=https://<slug>.clerk.accounts.dev
# CLERK_JWKS_URL=
# Production: comma-separated azp allow-list. Empty skips the azp check (local Clerk only).
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000

DATABASE_URL=postgresql+psycopg://secureai:secureai@127.0.0.1:5432/secureai
REDIS_URL=redis://127.0.0.1:6379/0
QUEUE_BACKEND=redis
QUEUE_KEY=secureai:jobs

STORAGE_BACKEND=filesystem
# Absolute path shared by the API and the worker. A relative path breaks after `cd apps/api`.
MEDIA_ROOT=/var/lib/secureai/media
# STORAGE_BACKEND=s3
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=secureai
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
# Leave false in production. true is for MinIO/local only.
# S3_AUTO_CREATE_BUCKET=false

# Per caller, per window. 0 disables a bucket. Redis-backed when QUEUE_BACKEND=redis.
# RATE_LIMIT_JOBS=30
# RATE_LIMIT_UPLOADS=60
# RATE_LIMIT_WINDOW_SECONDS=60
# DETECTOR_TIMEOUT_SECONDS=60
# STUCK_JOB_SECONDS=180
# JOB_MAX_ATTEMPTS=3

# Explicit origins only. The API rejects CORS_ORIGINS=*.
CORS_ORIGINS=http://localhost:3000

# Worker: cpu reads frames. stub hashes the path.
DETECTOR_MODE=cpu

# Stripe test mode. Leave empty on a private workstation.
# AUTH_MODE=dev with these empty skips quotas and logs a warning.
# AUTH_MODE=clerk with these empty keeps the free trial (10 jobs / month)
# and disables Checkout. Set QUOTA_MODE=enforce to apply that cap in dev too.
# Never commit live keys.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_TEAM=price_...
# PUBLIC_APP_URL=http://localhost:3000
# QUOTA_MODE=enforce
# QUOTA_FREE=10
# QUOTA_PRO=500
# QUOTA_TEAM=2000
# SEAT_LIMIT_FREE=3
# SEAT_LIMIT_TEAM=25

# Workspace job webhooks. The worker posts them. Defaults are 5 attempts and 10 seconds.
# WEBHOOK_MAX_ATTEMPTS=5
# WEBHOOK_TIMEOUT_SECONDS=10

# Report attestation. Leave the private key empty to disable it. Those routes
# then return 503 "Attestation is not configured". The value is an unencrypted
# PKCS8 Ed25519 PEM. A one-line value may use \n for line breaks. Do not commit a key.
# Generate a local key:
#   python -c 'from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey; from cryptography.hazmat.primitives import serialization; print(Ed25519PrivateKey.generate().private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, serialization.NoEncryption()).decode().replace(chr(10), "\\n"))'
# ATTESTATION_PRIVATE_KEY=
# ATTESTATION_KEY_ID=v1
# Public verify is limited per client address. 0 disables that bucket.
# RATE_LIMIT_ATTESTATIONS=60
