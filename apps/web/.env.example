# Clerk. Leave empty to build without signing in.
# https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# FastAPI origin. No trailing path.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Private workstation only. Leave unset when Clerk keys are set.
# The API must use AUTH_MODE=dev at the same time. Do not set this on a public host.
# NEXT_PUBLIC_AUTH_MODE=dev
