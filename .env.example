# SecureAI DeepFake Detection — example environment file.
# Copy to `.env` and fill in REAL values. NEVER commit a populated .env.
# All values below are PLACEHOLDERS only — they contain no real secrets.

# ---------------------------------------------------------------------------
# Core application secrets (REQUIRED — app/compose fail closed if unset)
# ---------------------------------------------------------------------------
# Flask/app session secret. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-strong-random-secret
# JWT signing key (must NOT be the literal 'your-secret-key'). Required by app/dependencies/auth.py.
JWT_SECRET_KEY=replace-with-strong-random-jwt-secret

# ---------------------------------------------------------------------------
# Database / Postgres
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=replace-with-strong-db-password
DB_PASSWORD=replace-with-strong-db-password
DATABASE_URL=postgresql://secureai:replace-with-strong-db-password@postgres:5432/secureai_db

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_URL=redis://:replace-with-strong-redis-password@redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ---------------------------------------------------------------------------
# AWS / S3 storage
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=your-upload-bucket
S3_RESULTS_BUCKET_NAME=your-results-bucket
USE_LOCAL_STORAGE=true

# ---------------------------------------------------------------------------
# CORS / hosting (SECURITY: do NOT use '*')
# ---------------------------------------------------------------------------
# Comma-separated allowed origins for CORS. Defaults to localhost dev origins if unset.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# Comma-separated allowed Host headers for TrustedHostMiddleware.
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Observability / 3rd-party APIs
# ---------------------------------------------------------------------------
SENTRY_DSN=
GEMINI_API_KEY=your-gemini-api-key

# ---------------------------------------------------------------------------
# Detection / upload tuning (optional)
# ---------------------------------------------------------------------------
# Max upload size in bytes (default 500 MB).
DETECTION_MAX_FILE_SIZE=524288000
UPLOAD_FOLDER=uploads
RESULTS_FOLDER=results

# ---------------------------------------------------------------------------
# Outbound download SSRF allowlist (optional)
# ---------------------------------------------------------------------------
# Comma-separated host suffixes allowed for URL-based downloads. Leave empty to
# allow any PUBLIC host (private/internal IPs are always blocked).
ALLOWED_DOWNLOAD_HOSTS=

# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------
# Netscape cookies.txt for X/Twitter URL analysis (path inside container).
X_COOKIES_FILE=
# Solana wallet keypair path (inside container).
SOLANA_WALLET_PATH=/app/wallet/id.json

# --- Rate limiting (slowapi) -------------------------------------------------
# Per-client limits on the expensive detect endpoints. Format: "N/minute".
RATE_LIMIT_DETECT=10/minute
RATE_LIMIT_DETECT_BATCH=3/minute
# In production point this at Redis so limits are shared across workers:
# RATE_LIMIT_STORAGE_URI=redis://:your-redis-password@redis:6379/1
RATE_LIMIT_STORAGE_URI=memory://
